{
  "name": "phy-sim",
  "productName": "Phy.Sim",
  "version": "1.1.0",
  "description": "Phy.Sim desktop shell — an interactive physics course with 132 live simulations",
  "main": "main.js",
  "author": "AkioArai",
  "license": "GPL-3.0",
  "homepage": "https://github.com/AkioArai/Phy.Sim",
  "scripts": {
    "prepare-app": "node prepare.mjs",
    "start": "npm run prepare-app && electron .",
    "dist": "npm run prepare-app && electron-builder --win --x64",
    "dist:portable": "npm run prepare-app && electron-builder --win portable --x64",
    "dist:fedora": "npm run prepare-app && electron-builder --linux rpm --x64",
    "dist:arch": "npm run prepare-app && electron-builder --linux pacman AppImage --x64"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ru.physim.app",
    "productName": "Phy.Sim",
    "directories": {
      "output": "out"
    },
    "publish": null,
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "shortcutName": "Phy.Sim",
      "license": "notice.txt",
      "include": "installer.nsh",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Phy.Sim-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Phy.Sim-portable-${version}.exe"
    },
    "linux": {
      "target": [
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "maintainer": "AkioArai <akioarai@users.noreply.github.com>",
      "category": "Education;Science;Physics",
      "icon": "build/icon.png",
      "synopsis": "Interactive physics course with 132 live simulations",
      "description": "Phy.Sim is an interactive physics course: notes, formulas, problems and 132 live simulations, from kinematics to particle physics. Works offline. Developed by the creator Somi together with Claude: the AI assistant wrote practically all of the notes, the mobile adaptation and the architecture, so bugs are possible — see the project page.",
      "desktop": {
        "Name": "Phy.Sim",
        "Comment": "Interactive physics course",
        "Categories": "Education;Science;Physics;",
        "StartupWMClass": "Phy.Sim",
        "Keywords": "physics;simulation;education;Irodov;физика;",
        "Comment[ru]": "Курс физики в живых моделях",
        "GenericName": "Physics course",
        "GenericName[ru]": "Курс физики"
      },
      "executableName": "phy-sim"
    },
    "rpm": {
      "artifactName": "Phy.Sim-${version}.x86_64.rpm"
    },
    "pacman": {
      "artifactName": "Phy.Sim-${version}-x86_64.pkg.tar.xz",
      "depends": [
        "gtk3",
        "nss",
        "libxss",
        "alsa-lib",
        "libnotify",
        "xdg-utils"
      ]
    },
    "appImage": {
      "artifactName": "Phy.Sim-${version}-x86_64.AppImage"
    }
  },
  "desktopName": "phy-sim.desktop"
}
