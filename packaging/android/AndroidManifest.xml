<?xml version="1.0" encoding="utf-8"?>
<!--
  Оболочка Android для Phy.Sim.

  Пособие целиком лежит в assets/ и открывается в WebView по file://.
  Интернет приложению не нужен: KaTeX, стили и все 76 симуляций внутри.

  Версии SDK задаёт build-apk.mjs (флаги aapt2), здесь их намеренно нет:
  атрибут в манифесте молча перебивает флаги. Сейчас это minSdk 21
  (Android 5.0) и targetSdk 34.

  Приложению не нужно ни одного разрешения и ни одной аппаратной
  возможности: ни камеры, ни сети, ни дополненной реальности. Проверить
  это можно на собранном пакете:

      aapt2 dump badging out/phy-sim.apk

  в выводе не должно быть ни uses-permission, ни ничего про
  com.google.ar — приложение работает на устройствах вообще без сервисов
  Google.
-->
<!-- Номер версии здесь тоже не пишем: его подставляет aapt2 из корневого
     package.json (флаги version-code и version-name в build-apk.mjs). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ru.physim.app">

  <!-- Разрешений нет вообще: приложение не выходит в сеть и не читает файлы. -->

  <application
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:allowBackup="true"
      android:hardwareAccelerated="true"
      android:theme="@android:style/Theme.Material.Light.NoActionBar">

    <activity
        android:name="ru.physim.app.MainActivity"
        android:exported="true"
        android:label="@string/app_name"
        android:screenOrientation="fullSensor"
        android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|smallestScreenSize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
